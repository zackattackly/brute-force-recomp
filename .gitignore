# Source only. No game data (xml exports, xbox_hdd, patches, dumps), no builds, no logs or screenshots.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/*.bat
!/ghidra_scripts/
!/tools/
!/dist/
!/loader/

/tools/__pycache__/
/tools/names.json
/tools/enums.json

/dist/*
!/dist/Install.bat
!/dist/install.ps1
!/dist/make_dist.ps1
!/dist/server.txt
!/dist/matchlist/
/dist/matchlist/.wrangler/
!/dist/files/
/dist/files/*
!/dist/files/play.bat
!/dist/files/online_port.ps1
!/dist/files/README.txt
!/dist/files/server.txt
!/dist/files/Start online server.bat
!/dist/files/razorback.stl
!/dist/files/razorback_tex.raw
!/dist/files/razor_reload.wav
!/dist/files/razor_shots.wav
!/dist/files/razorhand.txt
!/dist/files/razorhand_ready.txt
!/dist/files/bruteforce.ico

/loader/*
!/loader/*.c
!/loader/*.h
!/loader/*.def
!/loader/build.bat
!/loader/run_loader.bat
!/loader/rbench.bat
!/loader/bruteforce.ico
